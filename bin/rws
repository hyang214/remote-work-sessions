#!/usr/bin/env bash
set -euo pipefail

if (( BASH_VERSINFO[0] < 3 || (BASH_VERSINFO[0] == 3 && BASH_VERSINFO[1] < 2) )); then
  printf 'rws: missing local dependency: Bash 3.2+ required; found %s\n' "$BASH_VERSION" >&2
  exit 2
fi

SOURCE=${BASH_SOURCE[0]}
while [[ -L "$SOURCE" ]]; do
  DIR=$(CDPATH='' cd -P -- "$(dirname -- "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done

USER_CONFIG_DIR="$HOME/.config/rws"
RWS_VERSION=0.2.0
RWS_DOCS_URL="https://github.com/hyang214/remote-work-sessions/blob/main/README.md"
DEFAULT_SHPOOL_VERSION=0.9.8
RWS_SETUP_STEP_TOTAL=12

CONFIG_DIR=
DEVICE=default
DEVICE_OVERRIDE=
HOST=
CWD=
SESSION=
IDENTITY_FILE=
SHPOOL_BIN=shpool
PROMPT_MODE=skip
PROMPT_LABEL=
CONFIG_SETUP_VERSION=
CONFIG_SHPOOL_VERSION=
HOST_OVERRIDE=
CWD_OVERRIDE=
SESSION_OVERRIDE=
IDENTITY_FILE_OVERRIDE=
SHPOOL_BIN_OVERRIDE=
SSH_OPTIONS=()
SSH_OPTION_OVERRIDES=()
SETUP_CONTROL_DIR=
SETUP_CONTROL_PATH=
SETUP_CONTROL_HOST=
SETUP_CONTROL_OPENED=0
CODING_AGENT=
CODING_CWD=
CODING_ACCESS=default
RWS_USAGE_CONTEXT=root

usage() {
  cat <<'EOF'
Usage:
  rws [--config-dir DIR] [--device DEVICE] [--host HOST] [--cwd DIR] [--session SESSION] <command> [args]
  rws help [topic]

Most used:
  rws setup                   Add a device, then optionally create a session.
  rws new SESSION --pick-cwd  Create or attach a named session in a picked cwd.
  rws attach SESSION          Attach an existing session without changing cwd.
  rws sessions                List sessions on the selected device.
  rws --cwd DIR run -- CMD    Run a one-shot command in DIR.

Parameters and options:
  --config-dir DIR            Use a specific config directory.
  -d, --device DEVICE         Use devices/<device>.conf.
  -H, --host HOST             Override the configured SSH host.
  -C, --cwd DIR               Override the configured remote cwd.
  -s, --session SESSION       Override the configured default shpool session.
  -i, --identity-file FILE    Override the SSH identity file.
  -B, --shpool-bin FILE       Override the remote shpool binary.
  -o, --ssh-option OPTION     Add an SSH -o option, such as StrictHostKeyChecking=no.

Typical scenarios:
  rws setup
  rws new review --pick-cwd --agent codex
  rws attach review
  rws s
  rws --cwd '~/repo' run -- git status --short
  rws --device lab
  rws remove lab

More help:
  rws help scenarios          Scenario-oriented usage guide.
  rws help commands           Full command and option reference.
EOF
}

usage_scenarios() {
  cat <<'EOF'
Usage:
  rws help scenarios

Parameters and options:
  This topic has no options. Use rws help COMMAND for command-specific details.

First setup:
  rws setup
  # Adds a device, installs/verifies SSH key and shpool, then asks whether to
  # create an initial session. If created, the session is created in the
  # background and setup prints the attach command; it does not auto-attach.

Start a recoverable coding agent in a picked directory:
  rws new coding --pick-cwd --agent codex
  # Enters the selected directory and starts the official Codex CLI inside
  # shpool. Full access is the default.

  rws new coding-safe --cwd '~/repo' --agent codex --no-full-access
  # Uses the provider's normal permission behavior instead.

Start another supported coding agent:
  rws new claude-work --cwd '~/repo' --agent claude
  rws new kiro-work --cwd '~/repo' --agent kiro

Create an ordinary shell session in a picked directory:
  rws new review --pick-cwd
  rws session create build --pick-cwd

Create a session when you know the directory:
  rws new review --cwd '~/Documents/project'
  rws session create build --cwd '~/repo'

Reconnect to existing work after SSH disconnects:
  rws attach review
  rws force review
  rws sessions

Recover coding work after reboot or lost shpool state:
  rws attach coding
  # rws reads the saved agent/cwd/access metadata, recreates the shpool session,
  # enters that cwd, and asks the provider CLI to resume its latest conversation.

Run one command in a directory:
  rws --cwd '~/repo' run -- git status --short

Manage core entities:
  rws key create|get|list|update|remove
  rws device create|get|list|update|remove
  rws session create|get|list|update|delete|attach

Recover from a command-line mistake:
  rws new coding --agent unknown
  # The error is followed by this command's usage, parameters, and examples.
  rws help new
EOF
}

usage_commands() {
  cat <<'EOF'
Usage:
  rws help commands

Global:
  rws [-d DEVICE] [-H HOST] [-C CWD] [-s SESSION] [-i FILE] [-B FILE] [-o OPTION] COMMAND
  rws --config-dir DIR COMMAND
  rws -V | --version

Setup and devices:
  rws setup [-d DEVICE] [-H HOST] [-C CWD] [-s SESSION] [-S|-x] [-k MODE]
            [-i FILE] [-K|-N] [-b FILE] [-F] [-r MODE] [-B FILE]
            [-m compact|skip] [-l LABEL] [-o OPTION] [-n] [-y]
  rws device create DEVICE [setup options]
  rws device get [DEVICE]
  rws device update DEVICE [-H HOST] [-C CWD] [-s SESSION] [-i FILE]
                           [-B FILE] [-m compact|skip] [-l LABEL]
                           [-o OPTION] [--clear-*] [--default]
  rws device list
  rws device remove DEVICE
  rws remove [DEVICE]

Sessions:
  rws new SESSION [-C CWD] [-p] [-A codex|claude|kiro] [--no-full-access]
  rws attach [SESSION]
  rws force [SESSION]
  rws background [SESSION]
  rws session create SESSION [-C CWD] [-p]
  rws session get SESSION
  rws session list [-j|--json]
  rws session update SESSION --detach
  rws session delete SESSION [SESSION...]
  rws sessions [-j|--json]

Keys:
  rws key create [-i FILE] [-f]
  rws key get [-i FILE]
  rws key list
  rws key update [-i FILE] [-f]
  rws key remove [-i FILE] [-f]

Commands:
  rws check
  rws doctor
  rws status
  rws shell
  rws --cwd DIR run -- COMMAND [ARG...]
  rws detach [SESSION...]
  rws kill [SESSION...]

Parameters and options:
  Options are shown beside each command above. Global options must precede COMMAND.

Typical scenarios:
  rws help new
  rws help attach
  rws help scenarios
EOF
}

usage_setup() {
  cat <<'EOF'
Usage:
  rws setup [options]

Add a device, configure local and remote prerequisites, and verify it.
Creating an initial session is optional and uses a one-off cwd.

Parameters and options:
  -d, --device DEVICE
  -H, --host HOST
  -C, --cwd DIR
  -s, --session SESSION
  -S, --create-session
  -x, --no-create-session
  -k, --key-mode create|existing|skip
  -i, --identity-file FILE
  -K, --install-key
  -N, --no-install-key
  -b, --bootstrap-identity FILE
  -F, --force-key
  -r, --remote-install auto|check|skip
  --shpool-version VERSION
  -B, --shpool-bin FILE
  -m, --prompt-mode compact|skip
  -l, --prompt-label LABEL
  -o, --ssh-option OPTION
  --verify
  -n, --no-verify
  -y, --yes

Typical scenarios:
  rws setup
  rws setup --host devbox --cwd '~/repo' --no-create-session
  rws setup --device lab --host user@lab --key-mode existing
EOF
}

usage_key() {
  cat <<'EOF'
Usage:
  rws key create [-i|--identity-file FILE] [-f|--force]
  rws key get [-i|--identity-file FILE]
  rws key list
  rws key update [-i|--identity-file FILE] [-f|--force]
  rws key remove [-i|--identity-file FILE] [-f|--force]

Manage local SSH identity files referenced by rws devices.

Parameters and options:
  -i, --identity-file FILE    Select the local private-key path.
  -f, --force                 Confirm key replacement or deletion.

Typical scenarios:
  rws key list
  rws key create --identity-file ~/.ssh/rws_ed25519
  rws key remove --identity-file ~/.ssh/rws_ed25519 --force
EOF
}

usage_device() {
  cat <<'EOF'
Usage:
  rws device create DEVICE [setup options]
  rws device get [DEVICE]
  rws device update DEVICE [options]
  rws device list
  rws device remove DEVICE

Parameters and options:
  create DEVICE [setup options]  Accepts rws setup options; see rws help setup.
  get [DEVICE]                   Defaults to the selected device.
  list                           Accepts no additional arguments.
  remove DEVICE                  Deletes its config and recovery metadata.
  -H, --host HOST
  -C, --cwd DIR
  -s, --session SESSION
  -i, --identity-file FILE
  --clear-identity-file
  -B, --shpool-bin FILE
  -m, --prompt-mode compact|skip
  -l, --prompt-label LABEL
  --clear-prompt-label
  -o, --ssh-option OPTION
  --clear-ssh-options
  --default

Typical scenarios:
  rws device list
  rws device get lab
  rws device update lab --cwd '~/repo' --default
EOF
}

usage_session() {
  cat <<'EOF'
Usage:
  rws session create SESSION [-C|--cwd DIR] [-p|--pick-cwd]
  rws session get SESSION
  rws session list [-j|--json]
  rws session update SESSION --detach
  rws session delete SESSION [SESSION...]
  rws session attach [SESSION]

Session commands operate on the selected device's remote shpool sessions.
Creating a session creates the selected remote cwd when missing.
If the device has no cwd, pass --cwd or --pick-cwd when creating a session.

Parameters and options:
  -C, --cwd DIR               Use DIR only for the new session.
  -p, --pick-cwd              Pick the remote directory interactively.
  -j, --json                  Print session lists as JSON.
  --detach                    Detach the named live session.

Typical scenarios:
  rws session create build --pick-cwd
  rws session list --json
  rws session update build --detach
  rws session delete build
EOF
}

usage_new() {
  cat <<'EOF'
Usage:
  rws new SESSION [-C|--cwd DIR] [-p|--pick-cwd] [-A|--agent AGENT] [--no-full-access]

Attach to or create SESSION on the selected device. Use --pick-cwd to browse
the remote filesystem before creating the session in a one-off cwd. The picker
supports Tab path completion when the remote host has bash.
Use --agent codex, --agent claude, or --agent kiro once to make later attaches
recover the latest conversation for this cwd after remote shpool state is lost.
An agent starts with full access by default and keeps that mode on recovery.
Use --no-full-access to retain the provider's normal permission behavior.
Provider-owned onboarding, workspace-trust, or first-use safety prompts may
still appear once.

With --agent, the resulting behavior is:
  1. Resolve or interactively pick the remote cwd.
  2. Create/attach the named shpool session and enter that cwd.
  3. Start the selected agent automatically inside shpool.
  4. On later recovery, recreate shpool if needed and resume the provider's
     latest conversation for that cwd.

Default full-access launch and recovery mapping:
  codex   codex --dangerously-bypass-approvals-and-sandbox; recovery uses
          codex resume --last with the same official full-access option
  claude  claude --dangerously-skip-permissions; recovery adds --continue
  kiro    kiro-cli chat --trust-all-tools; recovery adds --resume
With --no-full-access, rws omits those full-access flags.

Parameters and options:
  -C, --cwd DIR               Use DIR for this session.
  -p, --pick-cwd              Pick the remote directory interactively.
  -A, --agent AGENT           Start codex, claude, or kiro automatically.
  --no-full-access            Keep normal provider permission behavior.
  --full-access               Compatibility flag; full access is already default.

Typical scenarios:
  rws new coding --pick-cwd --agent codex
  rws new coding --cwd '~/repo' --agent codex --no-full-access
  rws new claude-work --cwd '~/repo' --agent claude
  rws attach coding
EOF
}

usage_run() {
  cat <<'EOF'
Usage:
  rws run -- COMMAND [ARG...]

Run COMMAND in the selected device's remote cwd. stdout, stderr, and the remote
command exit code are preserved.

Parameters and options:
  --                            End rws options before COMMAND.
  -C, --cwd DIR                 Global option selecting the remote directory.

Typical scenarios:
  rws --cwd '~/repo' run -- git status --short
  rws --device lab --cwd '~/repo' run -- npm test
EOF
}

usage_attach() {
  cat <<'EOF'
Usage:
  rws attach [SESSION]

Attach an existing shpool session. If saved coding-agent metadata exists and
the remote session was lost, recreate it in the saved cwd and resume the agent.

Parameters and options:
  SESSION                     Optional session; defaults to the device setting.

Typical scenarios:
  rws attach coding
  rws --device lab attach review
EOF
}

